{
  "name": "shivalaya-resort-suite",
  "private": true,
  "version": "2.0.0",
  "description": "Integrated management suite for Shivalaya Resorts & Panache Restaurant",
  "scripts": {
    "dev": "pnpm --parallel --filter guest-portal --filter kitchen-panel --filter resort-reception dev",
    "dev:portal": "pnpm --filter guest-portal dev",
    "dev:guest": "pnpm --filter guest-portal dev",
    "dev:menu": "pnpm --filter guest-portal dev",
    "dev:kitchen": "pnpm --filter kitchen-panel dev",
    "dev:reception": "pnpm --filter resort-reception dev",
    "build:portal": "pnpm --filter guest-portal build",
    "build:guest": "pnpm --filter guest-portal build",
    "build:menu": "pnpm --filter guest-portal build",
    "build:kitchen": "pnpm --filter kitchen-panel build",
    "build:reception": "pnpm --filter resort-reception build",
    "build": "pnpm -r build",
    "test": "node --test tests/**/*.test.mjs",
    "check": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
